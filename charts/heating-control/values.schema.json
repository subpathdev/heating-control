{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "config": {
      "type": "object",
      "required": ["broker", "rooms"],
      "properties": {
        "broker": { "type": "string", "minLength": 1 },
        "rooms": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["id", "label", "trv"],
            "additionalProperties": false,
            "properties": {
              "id": { "type": "string", "minLength": 1 },
              "label": { "type": "string", "minLength": 1 },
              "trv": { "type": "string", "minLength": 1 },
              "sensor": { "type": "string" }
            }
          }
        }
      }
    },
    "service": {
      "type": "object",
      "properties": {
        "type": { "enum": ["ClusterIP", "NodePort"] }
      }
    }
  }
}
